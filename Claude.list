host, anthropic.com.cdn.cloudflare.net

# 认证 / 内容
host, anthropic.auth0.com
host, anthropic-com.ghost.io

# 监控和遥测（关键词规则也会匹配其他包含该词的域名）
host-suffix, sentry.io
host-suffix, statsigapi.net
host, browser-intake-us5-datadoghq.com
host-keyword, datadog
host-keyword, sift

# 客服 / 第三方 widget
host-suffix, intercom.io
host-suffix, intercomcdn.com
